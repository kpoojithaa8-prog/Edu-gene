# EduGenie Environment Configuration
# Get your Google Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Local AI Model Settings (MBZUAI/LaMini-Flan-T5-783M)
# Set to 'true' if you wish to download and run the local ~3GB model weights on CPU
DOWNLOAD_LOCAL_MODEL=false
USE_LOCAL_MODEL=true
